# Copy to .env and fill in. Never commit the real .env.

# Chat model — provider-swappable via any OpenAI-compatible endpoint.
# Currently Anthropic (Sonnet 5 handles the nested Composio meta-router args);
# swap these two lines + base_url in agent/llm.py to change provider.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Embeddings — Gemini (gemini-embedding-001, 1536 dims to match the vector column).
GEMINI_API_KEY=

# Web search.
TAVILY_API_KEY=

# Long-term memory store (Supabase / pgvector). Use the service_role key.
SUPABASE_URL=
SUPABASE_KEY=

# Composio — 1000+ app tools over MCP (Gmail, Slack, GitHub, ...). Optional.
COMPOSIO_API_KEY=

# Observability — LangFuse traces (one per turn, with token/cost/latency). Optional.
# Create a free project at https://cloud.langfuse.com to get these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram gateway — chat with Oajan from the Telegram app. Optional.
# Token from @BotFather (/newbot). ALLOWED_IDS is a comma-separated allowlist of
# Telegram user IDs permitted to use the agent (leave blank, message the bot once,
# and it replies with your ID to add here).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Speech-to-text — Groq Whisper via its OpenAI-compatible endpoint. Optional;
# enables voice notes in Telegram and voice input in the CLI.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
